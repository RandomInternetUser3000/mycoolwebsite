{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.+)\\.(png|jpg|jpeg|gif|svg|ico|webp|avif|woff2|woff)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.+)\\.(css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth" },
    { "source": "/api/admin/:path*", "destination": "/api/admin" },
    { "source": "/api/supabase-blog/:path*", "destination": "/api/blog" },
    { "source": "/api/projects/:path*", "destination": "/api/blog" },
    { "source": "/api/youtube/latest", "destination": "/api/youtube" },
    { "source": "/api/youtube/latest/:path*", "destination": "/api/youtube" },
    { "source": "/blog/post/:slug", "destination": "/blog/post" },
    { "source": "/projects/view/:slug", "destination": "/projects/view" }
  ]
}
